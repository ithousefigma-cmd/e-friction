# Django asosiy sozlamalari
SECRET_KEY=replace-with-a-long-random-string
DEBUG=False
# ALLOWED_HOSTS ni qo'ymasangiz ham bo'ladi (default: e-friction.uz, localhost va Railway domenlari)
# Agar qo'ysangiz Railway domeni ham qo'shilishi shart, aks holda 400 Bad Request chiqadi.
# Eslatma: Django 6 da wildcard domen nokta bilan yoziladi (.up.railway.app).
ALLOWED_HOSTS=e-friction.uz,www.e-friction.uz,localhost,127.0.0.1,.up.railway.app,.railway.app
SITE_URL=https://e-friction.uz

# PostgreSQL (ishlab chiqarish)
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME

# Ixtiyoriy: https majburiy qilish (False qilish mumkin agar proxy boshqarayotgan bo'lsa)
# SECURE_SSL_REDIRECT=True
